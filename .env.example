# ==============================================================================
# ESAAD (اصعد) SMM Platform - Environment Configuration Template
# Copy this file to .env and configure with your actual production settings.
# ==============================================================================

# Database Connection URL (SQLite for local, PostgreSQL recommended for production)
# Example PostgreSQL: "postgresql://username:password@localhost:5432/esaad_db?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret Key for Session Authentication (Generate a strong 64+ char random string)
JWT_SECRET="your_strong_random_jwt_secret_key_here_for_production"

# Environment & Server
NODE_ENV="production"
PORT=3000

# Public App URL & Metadata
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="اصعد | ESAAD"
NEXT_PUBLIC_APP_TAGLINE="منصة خدمات النمو الرقمي"

# Currency Configuration (USD is default and standard for SMM)
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_CURRENCY_SYMBOL="$"

# Cron Job Secret (for triggering automated order status and provider sync)
CRON_SECRET="your_secure_cron_secret_token_here"

# SMTP Mail Delivery Configuration (Gmail, Brevo, Zoho, Mailgun, SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password-or-smtp-password"
SMTP_FROM="منصة اصعد <no-reply@yourdomain.com>"

